<%- include('../partials/header') %>
    <%- include('../partials/navbar') %>


        <main class="flex-1 p-4 pb-16 flex flex-col items-center justify-center gap-4 w-full">
            <!-- Botones de acción -->
            <div class="flex gap-3 w-full lg:w-auto">
                <a href="/filtrar"
                    class="flex-1 lg:flex-none text-center text-sm font-medium bg-white border border-amber-200 hover:border-red-900 transition-transform duration-100 hover:scale-105 text-red-900 py-2 px-6 rounded-xl shadow-sm transition-colors">
                    🔍 Filtrar
                </a>
                <a href="/"
                    class="flex-1 lg:flex-none text-center text-sm font-medium bg-white border border-amber-200 hover:border-red-900 transition-transform duration-100 hover:scale-105 text-red-900 py-2 px-6 rounded-xl shadow-sm transition-colors">
                    🏠 Inicio
                </a>
            </div>
            <div class="flex flex-col lg:flex-row gap-4 w-full lg:w-auto">
                <!-- Gráfico 1: Ingresos por categoría -->
                <div
                    class="bg-white border border-amber-200 rounded-2xl p-5 flex flex-col gap-3 shadow-sm w-full lg:w-96">
                    <h2 class="text-base font-semibold text-green-700 mb-4">💰 Ingresos por categoría</h2>
                    <canvas id="chartIngresos"></canvas>
                </div>

                <!-- Gráfico 2: Egresos por categoría -->
                <div
                    class="bg-white border border-amber-200 rounded-2xl p-5 flex flex-col gap-3 shadow-sm w-full lg:w-96">
                    <h2 class="text-base font-semibold text-red-900 mb-4">💸 Gastos por categoría</h2>
                    <canvas id="chartEgresos"></canvas>
                </div>

                <!-- Gráfico 3: Balance total -->
                <div
                    class="bg-white border border-amber-200 rounded-2xl p-5 flex flex-col gap-3 shadow-sm w-full lg:w-96">
                    <h2 class="text-base font-semibold text-stone-700 mb-4 text-center">⚖️ Balance del mes</h2>
                    <canvas id="chartBalance"></canvas>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <div class="fixed bottom-0 left-0 right-0 bg-red-900 py-3 text-center shadow-lg">
            <p class="text-amber-100 text-sm font-semibold tracking-widest">@blas haberland</p>
        </div>
        <!-- Div para los datos -->
        <div id="datosServidor" class="hidden" data-ingresos="<%= JSON.stringify(ingresosPorCategoria) %>"
            data-egresos="<%= JSON.stringify(egresosPorCategoria) %>" data-totales="<%= JSON.stringify(totales) %>">
        </div>

        <!-- Chart.js CDN -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="/js/estadisticas.js"></script>


        </body>

        </html>