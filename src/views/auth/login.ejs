<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión — FinanzasCafé</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-amber-50 min-h-screen flex items-center justify-center">

    <div class="bg-white border border-amber-200 rounded-2xl shadow-sm p-8 w-full max-w-sm mx-4">

        <!-- Logo / título -->
        <div class="text-center mb-6">
            <p class="text-3xl mb-1">☕</p>
            <h1 class="text-2xl font-bold text-red-900">FinanzasCafé</h1>
            <p class="text-sm text-gray-400 mt-1">Casa Suiza</p>
        </div>

        <!-- Error -->
        <% if (error) { %>
            <div class="bg-red-50 border border-red-200 text-red-800 text-sm rounded-lg px-4 py-2 mb-4">
                <%= error %>
            </div>
            <% } %>

                <!-- Formulario -->
                <form method="POST" action="/login" class="flex flex-col gap-4">

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Nombre de usuario</label>
                        <input type="text" name="nombre" required autofocus placeholder="Nombre de usuario"
                            class="border border-gray-300 w-full p-2.5 rounded-lg text-sm focus:outline-none focus:border-red-900">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Contraseña</label>
                        <input type="password" name="password" required placeholder="••••••••"
                            class="border border-gray-300 w-full p-2.5 rounded-lg text-sm focus:outline-none focus:border-red-900">
                    </div>

                    <button type="submit"
                        class="w-full bg-red-900 hover:bg-red-800 text-amber-50 font-semibold py-2.5 rounded-xl transition-colors mt-2">
                        Ingresar
                    </button>

                </form>
    </div>

</body>

</html>