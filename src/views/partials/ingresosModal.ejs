<div id="modalIngreso" class="fixed inset-0 bg-black bg-opacity-50 hidden flex justify-center items-center z-50">
    <div class="bg-amber-50 rounded-lg p-6 w-full max-w-md mx-4">
        <h2 class="text-xl font-bold text-red-900 mb-4">Agregar Nuevo Ingreso</h2>

        <form id="formIngreso" action="/transacciones" method="POST">
            <!-- Campo oculto para el TIPO, se llena automáticamente -->
            <input type="hidden" name="tipo" id="tipoIngreso" value="ingreso">

            <!-- Campo oculto para la FECHA COMPLETA (Día + Hora) -->
            <input type="hidden" name="fecha" id="fechaReal">

            <!-- Descripción -->
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Descripción</label>
                <input type="text" name="descripcion"
                    class="border border-gray-300 w-full p-2 rounded focus:ring-green-500 focus:border-green-500"
                    placeholder="Ej: Venta de café" required>
            </div>

            <!-- Monto -->
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Monto ($)</label>
                <input type="number" step="0.01" name="monto"
                    class="border border-gray-300 w-full p-2 rounded focus:ring-green-500 focus:border-green-500"
                    placeholder="0.00" required>
            </div>

            <!-- Categoría -->
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Categoría</label>
                <select name="id_categoria" id="categoriaSelect"
                    class="border border-gray-300 w-full p-2 rounded focus:ring-green-500 focus:border-green-500"
                    required onchange="actualizarTipoCategoria()">
                    <option value="" disabled selected>Seleccione una categoría</option>
                    <% categorias.forEach(cat=> { %>
                        <!-- Usamos data-tipo para guardar el tipo_asociado oculto en el HTML -->
                        <option value="<%= cat.id_categoria %>" data-tipo="<%= cat.tipo_asociado %>">
                            <%= cat.nombre %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <!-- Método de Pago (Requerido por el backend) -->
            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Método de Pago</label>
                <select name="id_metodo"
                    class="border border-gray-300 w-full p-2 rounded focus:ring-green-500 focus:border-green-500"
                    required>
                    <% metodos.forEach(metodo=> { %>
                        <option value="<%= metodo.id_metodo %>">
                            <%= metodo.nombre %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <!-- Fecha (El usuario solo elige el día) -->
            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Fecha</label>
                <input type="date" id="fechaVisual"
                    class="border border-gray-300 w-full p-2 rounded focus:ring-green-500 focus:border-green-500"
                    required>
            </div>

            <!-- Botones -->
            <div class="flex justify-end gap-3">
                <button type="button" class="bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300 transition"
                    onclick="cerrarModalIngreso()">Cancelar</button>
                <button type="submit"
                    class="bg-green-700 text-white px-4 py-2 rounded hover:bg-green-800 transition">Guardar
                    Ingreso/Egreso</button>
            </div>
        </form>
    </div>
</div>